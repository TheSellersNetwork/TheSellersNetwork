# Copy to .env.local and fill in. .env.local is never committed.
# Ask Tom for any value you do not have.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Brand palette: navy | teal | slate | forest (see /brand)
NEXT_PUBLIC_BRAND=slate

# Supabase (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server only, never sent to the client)
SUPABASE_SERVICE_ROLE_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Later tasks
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AKISMET_API_KEY=

# Email sending identity and the account that owns seeded content
EMAIL_FROM="The Sellers Network <hello@yourdomain.co.uk>"
SEED_AUTHOR_EMAIL=

# Cron protection (Vercel sends this as a bearer token) and the salt for impression hashes
CRON_SECRET=
PLACEMENT_HASH_SALT=

# Site default visual style: publication | editorial | compact | warm (see /brand)
NEXT_PUBLIC_STYLE=warm

# Mentoring and course are hidden from public pages until they launch
NEXT_PUBLIC_SHOW_MENTORING=false
NEXT_PUBLIC_SHOW_COURSE=false

# Web push notifications. Generate a pair with: npx web-push generate-vapid-keys
# The public key is sent to browsers; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address push services can use, as mailto:you@example.com
VAPID_SUBJECT=

# Business details shown on /about, /privacy, /terms and the footer. Leave blank until decided.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_COMPANY_NUMBER=
# ICO data protection fee registration number
NEXT_PUBLIC_ICO_NUMBER=
